# Local backend. Copy to .env and replace the credential; never commit .env.
RAG_ENV=development
RAG_DATA_DIR=./data
RAG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Generate with: python manage.py hash-password
# Keep single quotes when sourcing: the hash contains literal dollar signs.
RAG_ACCESS_CODE_HASH='REPLACE_WITH_GENERATED_HASH'
RAG_MODEL_CACHE=./.model-cache
RAG_MODEL_OFFLINE=1
RAG_MIN_SIMILARITY=0.30
RAG_MAX_STORAGE_BYTES=1073741824
RAG_MAX_DOCUMENTS=1000
RAG_MAX_CHUNKS=20000
RAG_MAX_PDF_PAGES=200
RAG_PARSE_TIMEOUT_SECONDS=30
